# Same base names as the frontend's VITE_SUPABASE_* vars, minus the Vite prefix
# (this is a Node process, not bundled by Vite).

# Your Supabase project URL — same value as frontend VITE_SUPABASE_URL
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Service-role key (NOT the anon key) — lets the server call auth.getUser()
# to verify tokens server-side. Get it from Supabase Dashboard > Project
# Settings > API > service_role secret. NEVER expose this to the frontend
# or commit it to git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Port the Socket.io/Express server listens on
PORT=4000

# Comma-separated list of origins allowed to connect (your GitHub Pages URL
# and local dev URL)
CORS_ORIGIN=http://localhost:5173,https://OG-Saphal.github.io

# How long (ms) a disconnected player has to reconnect mid-race before being
# marked abandoned/DNF. Spec calls for 20-30s.
RECONNECT_GRACE_MS=25000

# Room cleanup sweep interval and idle timeout (ms)
CLEANUP_SWEEP_INTERVAL_MS=60000
IDLE_ROOM_TIMEOUT_MS=1200000
